# HazeGuard AI — environment template
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.

# ---- application ----
APP_ENV=development          # development | production
APP_DEBUG=true               # true shows error detail in JSON; must be false in production
# Where the app is reachable. Used only to write the sign-in URL into the welcome
# mail; leave it unset and that line is simply omitted. Nothing breaks if it is
# wrong, because password reset sends a typed code rather than a link — a link
# built from this value pointed at a dead port whenever the value was stale, and
# could not be opened at all from a phone.
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kuala_Lumpur

# ---- database ----
# Dev uses XAMPP's MariaDB (drop-in for MySQL); production targets MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hazeguard
DB_USER=hazeguard_app
DB_PASS=                     # least-privilege app user, NOT root

# ---- sessions / CSRF ----
SESSION_NAME=hzgsid
SESSION_LIFETIME=1209600     # seconds (14 days)
CSRF_KEY=                    # 32+ random bytes, hex; used to sign CSRF tokens

# ---- mail ----
# log  = write .eml files to MAIL_LOG_DIR (dev default, no provider needed)
# brevo = send via Brevo HTTP API (needs an API key, see below)
MAIL_DRIVER=log
# With MAIL_DRIVER=brevo this must be an address Brevo has verified as a sender
# (Senders, Domains and IPs in the Brevo dashboard). A domain you do not own —
# e.g. anything @*.local — is refused, so every send fails with HTTP 400.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=HazeGuard AI
MAIL_LOG_DIR=storage/mail

# TLS trust store, used only when php.ini sets neither curl.cainfo nor
# openssl.cafile. Without one, every HTTPS request from PHP fails with
# "unable to get local issuer certificate" — which reads like a network fault
# but is a missing file. XAMPP ships one at apache/bin/curl-ca-bundle.crt.
#
# Despite the name this is the trust store for ALL outbound HTTPS from PHP —
# mail and the air-quality API alike. HTTP_CA_BUNDLE overrides it if the two
# ever need to differ.
MAIL_CA_BUNDLE=

# Brevo (https://www.brevo.com) — free tier: 300 emails/day.
# The API key is read from the first of these that is set:
#   1. BREVO_API_KEY below — the deployment override.
#   2. The encrypted credential named by BREVO_CREDENTIAL, saved by an
#      administrator in the Credentials panel (stored as ciphertext, so a
#      database dump does not leak a working key). Preferred for production.
BREVO_API_KEY=
BREVO_CREDENTIAL=Brevo
# NOTE: if Brevo has IP allow-listing switched on for the account, every request
# from an unlisted address fails with HTTP 401 "unrecognised IP address" before
# anything is sent. Add the server's address at
# https://app.brevo.com/security/authorised_ips — or switch the restriction off.

# ---- air quality ----
# The reading is fetched server-side (Model/AirModel.php) and cached to a file,
# so one upstream call serves every visitor until the TTL expires. Open-Meteo's
# `current` block only advances hourly, so an hour is safe — a cached value
# cannot be wrong within its TTL. Relative paths resolve from the project root;
# storage/ is gitignored, so no cached reading is ever committed.
AIR_CACHE_DIR=storage/cache/air
AIR_CACHE_TTL=3600

# ---- credential encryption ----
# AES-256-GCM key used to encrypt stored API keys. 64 hex characters (32 bytes).
# Generate one with:  php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Changing it makes every stored credential unreadable, so keep it with your backups.
CREDENTIAL_KEY=

# ---- security limits ----
OTP_TTL_SECONDS=300          # 5 minutes; also the password-reset code lifetime
OTP_MAX_ATTEMPTS=5
VERIFY_TOKEN_TTL_SECONDS=86400
